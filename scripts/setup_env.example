# Copy to .env (git-ignored) and fill in real values:
#   cp scripts/setup_env.example .env
#
# `make init` does this for you automatically (never overwriting an
# existing .env). Every value below is either a safe local-development
# placeholder or empty -- never a real credential. See README.md's
# "Configuration" section for the full, authoritative list of variables
# (src/tuva_ingest/config.py's IngestConfig.load() is the single source
# of truth for defaults and validation).

# --- PostgreSQL -------------------------------------------------------
export PG_DSN="postgresql://tuva_local:local-only-example-password-change-me@127.0.0.1:5432/tuva"
# Six-schema lineage (see docs/SOURCE_CONTRACT.md "Schema lineage"):
# ops -> raw_incoming -> staging_incoming -> input_layer -> analytics_core/
# analytics_marts. NOTE: these defaults changed from raw/ingest_ops as
# part of adding object storage -- an EXISTING deployment that never set
# RAW_SCHEMA/OPS_SCHEMA explicitly must set them to its CURRENT values
# (raw/ingest_ops) here to keep reading its existing data; see
# docs/RUNBOOK.md "Upgrade notes".
export RAW_SCHEMA="raw_incoming"
export OPS_SCHEMA="ops"
export STAGING_SCHEMA="staging_incoming"
export INPUT_LAYER_SCHEMA="input_layer"
export ANALYTICS_CORE_SCHEMA="analytics_core"
export ANALYTICS_MARTS_SCHEMA="analytics_marts"
export INGEST_ROLE="tuva_ingest_role"
export TRANSFORM_ROLE="tuva_transform_role"

# --- Object storage (src/tuva_ingest/object_storage/) ------------------
# The durable, immutable, replayable source of truth for extracted
# source pages -- see docs/SOURCE_CONTRACT.md "Object storage".
# "local" (default): a real-file-I/O local backend for development/CI,
#   never a production object store. "s3": AWS S3 or any S3-compatible
#   endpoint (set OBJECT_STORAGE_ENDPOINT_URL for MinIO -- see
#   compose.yml's `minio` service). No static access-key/secret-key
#   setting here on purpose -- authentication is always boto3's ambient
#   credential chain (an IAM role, AWS_PROFILE, or a local developer
#   profile); see object_storage/s3.py.
export OBJECT_STORAGE_PROVIDER="local"
export OBJECT_STORAGE_BUCKET=""
export OBJECT_STORAGE_PREFIX="raw"
export OBJECT_STORAGE_REGION=""
export OBJECT_STORAGE_ENDPOINT_URL=""
export OBJECT_STORAGE_LOCAL_ROOT="data/object_storage"

# --- Ingestion API (leave unset for migrate/healthcheck-only workflows) --
# TUVA_API_MANIFEST_URL is the page-request URL for `extract`/`sync`
# (paginated JSON contract, see docs/SOURCE_CONTRACT.md "Pagination") --
# requested with `?endpoint=<name>` (`&since=<date>` when resolved, and
# `&page_token=...`/`&page_size=...` as pagination proceeds). The legacy
# `run`/`load-raw` full-manifest CSV contract (docs/API_MANIFEST.md)
# reuses this same URL, unparameterized.
export TUVA_API_MANIFEST_URL=""
# TUVA_API_TOKEN is read directly ONLY when TUVA_API_SECRET_PROVIDER=env
# (the default -- see below). With TUVA_API_SECRET_PROVIDER=aws, leave
# this unset; the credential is retrieved at runtime from AWS Secrets
# Manager instead (src/tuva_ingest/secrets.py).
export TUVA_API_TOKEN=""
# TUVA_API_TIMEOUT_SECONDS is the fallback for every httpx timeout phase
# (connect/read/write/pool) -- set the phase-specific variables below
# only if you need asymmetric bounds (e.g. a slow connect but fast read).
export TUVA_API_TIMEOUT_SECONDS="30"
export TUVA_API_CONNECT_TIMEOUT_SECONDS=""
export TUVA_API_READ_TIMEOUT_SECONDS=""
export TUVA_API_WRITE_TIMEOUT_SECONDS=""
export TUVA_API_POOL_TIMEOUT_SECONDS=""
export TUVA_API_MAX_RETRIES="5"
# Hard ceiling (seconds) on any single retry sleep -- bounds both the
# exponential-backoff-with-jitter schedule and a Retry-After header from
# a 429/5xx response; a Retry-After value larger than this is capped,
# never honored as-is.
export TUVA_API_MAX_RETRY_DELAY_SECONDS="30"
export TUVA_API_ALLOW_INSECURE_HTTP="0"

# --- Cloud secret manager (src/tuva_ingest/secrets.py) ------------------
# "env" (default): read TUVA_API_TOKEN above directly -- every existing
#   local-dev/CI/test workflow keeps working unchanged.
# "aws": retrieve the credential from AWS Secrets Manager at runtime,
#   using ambient identity only (an IAM role, an assumed role,
#   AWS_PROFILE, or a local developer profile) -- never a static access
#   key configured here. Requires TUVA_API_SECRET_ID. Expected secret
#   JSON shape: {"api_token": "<the bearer token>"}.
export TUVA_API_SECRET_PROVIDER="env"
export TUVA_API_SECRET_ID=""
export AWS_REGION=""

# --- Paginated extraction (src/tuva_ingest/pagination.py) ---------------
# TUVA_API_PAGE_SIZE is optional -- omit to let the source pick its own
# default page size; when set, sent as the `page_size` query parameter.
export TUVA_API_PAGE_SIZE=""
# Hard ceiling on pagination loop iterations -- the final defense against
# an infinite pagination loop.
export TUVA_API_MAX_PAGES="10000"
# Per-page response size ceiling, in bytes.
export TUVA_API_MAX_PAGE_BYTES="67108864"

# --- Extraction / raw snapshots ---------------------------------------
export RAW_DATA_DIR="data/raw"
export SOURCE_NAME="tuva"

# --- dbt ---------------------------------------------------------------
export DBT_TARGET="dev"
export DBT_PROFILES_DIR="."
export DBT_PROJECT_DIR="."

# --- Pipeline / logging --------------------------------------------------
export PIPELINE_ENVIRONMENT="local"
export PIPELINE_MAX_SUCCESS_AGE_HOURS="30"
export LOG_LEVEL="INFO"
