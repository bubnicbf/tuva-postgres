# Version control / CI
.git/
.github/

# Secrets -- never baked into an image (profiles.yml is generated in the
# image from profiles.example.yml, see Dockerfile -- a local override
# should never be copied in)
.env
*.env
profiles.yml

# Local data, temp, and generated dbt artifacts
data/
tmp/
logs/
target/
dbt_packages/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Tests are not needed at runtime (they still ship in the git
# repo/CI checkout, just not in the image)
tests/
docs/

# Editor/OS cruft
.DS_Store
